student-data.py
import mysql.connector

conn = mysql.connector.connect(user='root', database='my-db', host="mysql-cont", password="root")
cursorA = conn.cursor(buffered=True)

cursorA.execute("CREATE TABLE IF NOT EXISTS `student-data` (name VARCHAR(20), phone_no BIGINT)")

cursorA.execute("INSERT INTO `student-data` VALUES ('OmS', 1238712345)")

conn.commit()

cursorA.close()
conn.close()
print("Data inserted successfully!")
